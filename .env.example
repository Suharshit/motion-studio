# Fish Audio — https://fish.audio (API keys: https://fish.audio/app/api-keys)
FISH_API_KEY=your_fish_audio_api_key

# Default voice model id (the "reference_id"). Find one with: npm run voices -- --search "deep male narrator"
FISH_VOICE_ID=

# TTS model header. s2.1-pro is the default; s2.1-pro-free on the free dev tier; drama-3-preview for directed/emotive reads.
FISH_TTS_MODEL=s2.1-pro

# Speech-to-text model used for word-level caption timestamps
FISH_STT_MODEL=transcribe-1-pro

# Optional: path to a Chrome/Chromium binary if Remotion can't download its own
# REMOTION_BROWSER=/usr/bin/chromium
